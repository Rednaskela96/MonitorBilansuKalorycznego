<Window x:Class="MonitorBilansuKalorycznego.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Bilansu Kalorycznego" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">

    <Window.Resources>
        <Style TargetType="Button" x:Key="MenuButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"/>
            </Border.Effect>

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="OloFit" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="Black"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Statystyki" Style="{StaticResource MenuButton}" Click="Nav_Dashboard_Click"/>
                    <Button Content="Dziennik" Style="{StaticResource MenuButton}" Click="Nav_Journal_Click"/>
                    <Button Content="Baza danych" Style="{StaticResource MenuButton}" Click="Nav_Database_Click"/>
                </StackPanel>

                <Ellipse Grid.Column="2" Width="35" Height="35" Fill="#E0E0E0" Cursor="Hand" MouseLeftButtonDown="Nav_Profile_Click"/>
            </Grid>
        </Border>

        <ContentControl x:Name="ActiveView" Grid.Row="1" Margin="20"/>
    </Grid>
</Window>