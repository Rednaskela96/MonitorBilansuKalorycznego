<UserControl x:Class="MonitorBilansuKalorycznego.View.FoodDatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F6FA" d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="TabRadioStyle" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,25,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" Padding="0,8,0,8" BorderThickness="0,0,0,2" x:Name="Border" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#2ECC71"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2ECC71"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Page header -->
            <TextBlock Text="Baza danych" FontSize="24" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,4"/>
            <TextBlock Text="Zarzadzaj swoimi produktami oraz cwiczeniami w tym panelu" Foreground="#888" FontSize="13" Margin="0,0,0,20"/>

            <!-- Tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton Content="Produkty spozywcze" IsChecked="True" GroupName="DbTabs"
                             Style="{StaticResource TabRadioStyle}" Checked="Tab_Products_Checked"/>
                <RadioButton Content="Aktywnosci fizyczne" GroupName="DbTabs"
                             Style="{StaticResource TabRadioStyle}" Checked="Tab_Activities_Checked"/>
                <RadioButton Content="Zestawy dan" GroupName="DbTabs"
                             Style="{StaticResource TabRadioStyle}" Checked="Tab_MealSets_Checked"/>
            </StackPanel>

            <!-- Search bar card -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="Twoje produkty" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Zarzadzaj nazwami i wartosciami odżywczymi produktow" Foreground="#999" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" BorderThickness="1" BorderBrush="#E0E0E0" CornerRadius="8" Height="40" Width="220" Margin="15,0">
                        <Grid>
                            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="32,0,10,0" BorderThickness="0" Background="Transparent"
                                     TextChanged="SearchBox_TextChanged" FontSize="13"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#BBB" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Wyszukaj produkty..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="32,0,0,0" Foreground="#CCC" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnAdd" Grid.Column="2" Content="+ Dodaj produkt" Click="BtnAdd_Click"
                            Background="#2ECC71" Foreground="White" FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                            Padding="18,0" Height="40" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Data table -->
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column" Background="White" RowHeight="52"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F5F5F5"
                          ColumnHeaderHeight="45">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Padding" Value="20,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="#999"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="20,0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FAFFFE"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nazwa produktu" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold"/>

                        <DataGridTextColumn x:Name="ColKcalProd" Header="Kcal/100g" Binding="{Binding CaloriesPer100g}" Width="100"/>
                        <DataGridTextColumn x:Name="ColProt" Header="Bialko (g)" Binding="{Binding Protein}" Width="100"/>
                        <DataGridTextColumn x:Name="ColCarbs" Header="Weglowodany (g)" Binding="{Binding Carbs}" Width="120"/>
                        <DataGridTextColumn x:Name="ColFat" Header="Tluszcze (g)" Binding="{Binding Fat}" Width="100"/>

                        <DataGridTextColumn x:Name="ColKcalAct" Header="Spalanie (kcal/h)" Binding="{Binding CaloriesPerHour}" Width="150" Visibility="Collapsed"/>

                        <DataGridTextColumn x:Name="ColSetItems" Header="Produkty w zestawie" Binding="{Binding ItemsSummary}" Width="2*" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColSetCalories" Header="Kalorie (kcal)" Binding="{Binding TotalCalories, StringFormat=N0}" Width="120" Visibility="Collapsed"/>

                        <DataGridTemplateColumn Header="Akcje" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Click="BtnEdit_Click" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Edytuj" Foreground="#BBB" FontSize="14" Margin="0,0,8,0" Padding="4"/>
                                        <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Click="BtnDelete_Click" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Usun" Foreground="#BBB" FontSize="14" Padding="4"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
