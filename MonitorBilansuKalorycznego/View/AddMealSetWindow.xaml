<!-- AddMealSetWindow.xaml — okno dialogowe tworzenia/edycji zestawu dań.-->
<Window x:Class="MonitorBilansuKalorycznego.View.AddMealSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zestaw posilkow" Height="500" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="White">
    <Border Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Utworz zestaw posilkow" FontSize="20" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,20"/>

            <!-- Set name -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Nazwa zestawu:" Foreground="#666" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="InputSetName" Height="38" Padding="10,0" FontSize="14"
                         VerticalContentAlignment="Center" BorderBrush="#E0E0E0">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>

            <!-- Add product to set -->
            <Border Grid.Row="2" Background="#F8F8F8" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ComboProducts" DisplayMemberPath="Name" Height="34" Padding="8,0" FontSize="13" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="InputItemAmount" Grid.Column="1" Text="100" Height="34" Padding="8,0" FontSize="13"
                             VerticalContentAlignment="Center" Margin="8,0" BorderBrush="#DDD">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Grid.Column="2" Content="+ Dodaj" Click="BtnAddItem_Click" Height="34" Padding="12,0"
                            Background="#1E3A8A" Foreground="White" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Items list -->
            <Border Grid.Row="3" BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="8" Padding="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Foreground="#888" FontSize="11">
                                                <Run Text="{Binding Amount, Mode=OneWay}"/><Run Text="g"/></TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <Run Text="{Binding CalculateCalories, StringFormat=N0, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                            <Run Text=" kcal" Foreground="#1E3A8A" FontSize="11"/>
                                        </TextBlock>
                                        <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="BtnRemoveItem_Click"
                                                Background="Transparent" BorderThickness="0" Foreground="#CCC" FontSize="12" Cursor="Hand" Padding="4" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,15,0,0">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Suma: " Foreground="#666"/>
                    <Run x:Name="TxtTotalCalories" Text="0" FontWeight="Bold" Foreground="#1A1A2E"/>
                    <Run Text=" kcal" Foreground="#666"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" IsCancel="True" Width="90" Height="38" Background="Transparent" BorderThickness="0" Foreground="#888" Cursor="Hand"/>
                    <Button Content="Zapisz zestaw" Click="BtnSave_Click" Height="38" Padding="18,0"
                            Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
