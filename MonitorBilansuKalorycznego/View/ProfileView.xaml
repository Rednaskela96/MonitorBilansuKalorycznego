<UserControl x:Class="MonitorBilansuKalorycznego.View.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,50,0">
            <TextBlock Text="Twój Profil" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Imię:" Foreground="#666"/>
            <TextBox x:Name="InputName" Height="35" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Wiek:" Foreground="#666"/>
            <TextBox x:Name="InputAge" Height="35" Margin="0,5,0,15" Padding="5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Waga (kg):" Foreground="#666"/>
                    <TextBox x:Name="InputWeight" Height="35" Margin="0,5,0,15" Padding="5"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Wzrost (cm):" Foreground="#666"/>
                    <TextBox x:Name="InputHeight" Height="35" Margin="0,5,0,15" Padding="5"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Płeć:" Foreground="#666"/>
            <ComboBox x:Name="ComboGender" Height="35" Margin="0,5,0,15"/>

            <TextBlock Text="Poziom aktywności:" Foreground="#666"/>
            <ComboBox x:Name="ComboActivity" Height="35" Margin="0,5,0,25"/>

            <Button Content="Zapisz i Przelicz Cel" Click="BtnSave_Click" Height="45" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Background="#F9F9F9">
            <Border Padding="30" CornerRadius="10" Background="#F0Fdf4" BorderBrush="#2ECC71" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Twój dzienny cel:" FontSize="16" Foreground="#555" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtResultGoal" Text="0 kcal" FontSize="40" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,10"/>
                    <TextBlock Text="Obliczono na podstawie BMR i aktywności." FontSize="12" Foreground="#888" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="Ręczna korekta celu (opcjonalnie):" FontSize="12" Foreground="#666"/>
                    <TextBox x:Name="InputCustomGoal" Height="35" Margin="0,5,0,10" Padding="5"/>
                    <Button Content="Ustaw ręczny cel" Click="BtnCustomGoal_Click" Background="Transparent" BorderBrush="#2ECC71" BorderThickness="1" Foreground="#2ECC71" Height="30"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>