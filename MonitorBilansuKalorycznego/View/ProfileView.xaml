<!-- ProfileView.xaml — widok profilu użytkownika (dane osobowe + cel kaloryczny)-->
<UserControl x:Class="MonitorBilansuKalorycznego.View.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2ECC71"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <TextBlock Text="Twoj Profil" FontSize="24" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,4"/>
            <TextBlock Text="Uzupelnij dane, aby obliczyc dzienne zapotrzebowanie kaloryczne" Foreground="#888" FontSize="13" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: form -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="30">
                    <StackPanel>
                        <TextBlock Text="Dane osobowe" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,20"/>

                        <TextBlock Text="Imie" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InputName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                        <TextBlock Text="Wiek" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InputAge" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Waga (kg)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="InputWeight" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Wzrost (cm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="InputHeight" Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Plec" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ComboGender" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16"/>

                        <TextBlock Text="Poziom aktywnosci" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ComboActivity" Style="{StaticResource ModernComboBox}" Margin="0,0,0,25"/>

                        <Button Content="Zapisz i Przelicz Cel" Click="BtnSave_Click" Height="45"
                                Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right: goal display -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="30" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Twoj dzienny cel" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Obliczono na podstawie BMR i aktywnosci" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <Border Background="#F0FDF4" CornerRadius="12" Padding="25" Margin="0,0,0,25">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtResultGoal" Text="0 kcal" FontSize="36" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center"/>
                                <TextBlock Text="dziennie" FontSize="12" Foreground="#888" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Reczna korekta celu (opcjonalnie)" FontSize="12" Foreground="#666" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="InputCustomGoal" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>
                                <Button Content="Ustaw reczny cel" Click="BtnCustomGoal_Click" Height="38"
                                        Background="Transparent" BorderBrush="#2ECC71" BorderThickness="1.5" Foreground="#2ECC71" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Sekcja resetowania danych -->
                        <Border BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Padding="0,25,0,0" Margin="0,25,0,0">
                            <StackPanel>
                                <TextBlock Text="Strefa niebezpieczna" FontSize="12" Foreground="#E74C3C" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Ta operacja usunie wszystkie dane i przywroci aplikacje do stanu poczatkowego." 
                                           FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button Content="Wyzeruj baze danych" Click="BtnResetDatabase_Click" Height="38"
                                        Background="#E74C3C" BorderThickness="0" Foreground="White" FontWeight="SemiBold" FontSize="13" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
