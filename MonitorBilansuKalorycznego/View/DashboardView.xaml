<UserControl x:Class="MonitorBilansuKalorycznego.View.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F5F6FA">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Header -->
            <TextBlock Text="Twoje statystyki" FontWeight="Bold" FontSize="24" Foreground="#1A1A2E" Margin="0,0,0,4"/>
            <TextBlock Text="Sprawdzaj historię swoich dni i jakie robisz postępy" Foreground="#888" FontSize="13" Margin="0,0,0,25"/>

            <!-- Top row: 3 cards -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Dzisiejszy bilans -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title + icon -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Dzisiejszy bilans" FontWeight="Bold" FontSize="15" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#FFF3E0" CornerRadius="8" Width="32" Height="32">
                                <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F97316"/>
                            </Border>
                        </Grid>

                        <!-- Donut chart with center text -->
                        <Grid Grid.Row="1" Margin="0,5,0,10">
                            <lvc:PieChart x:Name="PieChartBalance"
                                          Height="170" Width="170"
                                          HorizontalAlignment="Center"
                                          InitialRotation="-90"
                                          TooltipPosition="Hidden"
                                          LegendPosition="Hidden"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBalanceValue" Text="0" FontWeight="Bold" FontSize="32" HorizontalAlignment="Center" Foreground="#1A1A2E"/>
                                <TextBlock x:Name="TxtBalanceGoal" Text="z 0 kcal" FontSize="12" Foreground="#999" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom stats -->
                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,3">
                                <TextBlock Text="Spożyte" Foreground="#666" FontSize="12"/>
                                <TextBlock x:Name="TxtConsumedToday" Text="0 kcal" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#1A1A2E"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Spalone" Foreground="#666" FontSize="12"/>
                                <TextBlock x:Name="TxtBurnedToday" Text="0 kcal" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12" Foreground="#1A1A2E"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <TextBlock Text="Bilans netto" Foreground="#666" FontSize="12"/>
                                <TextBlock x:Name="TxtNetBalance" Text="Pozostało 0kcal" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#2ECC71"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Wykres tygodniowy -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title + icon -->
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <TextBlock Text="Wykres tygodniowy" FontWeight="Bold" FontSize="15" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#E8EAF6" CornerRadius="8" Width="32" Height="32">
                                <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Weekly bars with labels -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <!-- Day labels -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Pon" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                                <TextBlock Text="Wt" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                                <TextBlock Text="Śr" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                                <TextBlock Text="Czw" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                                <TextBlock Text="Pt" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                                <TextBlock Text="Sob" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                                <TextBlock Text="Nd" Foreground="#666" FontSize="11" Height="28" Padding="0,7,0,0"/>
                            </StackPanel>

                            <!-- Bar chart area -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Height="28"><Border x:Name="Bar0" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                                <Grid Height="28"><Border x:Name="Bar1" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                                <Grid Height="28"><Border x:Name="Bar2" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                                <Grid Height="28"><Border x:Name="Bar3" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                                <Grid Height="28"><Border x:Name="Bar4" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                                <Grid Height="28"><Border x:Name="Bar5" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                                <Grid Height="28"><Border x:Name="Bar6" Background="#5B6ABF" CornerRadius="3" Height="8" HorizontalAlignment="Left"/></Grid>
                            </StackPanel>

                            <!-- Value labels -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="Val0" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                                <TextBlock x:Name="Val1" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                                <TextBlock x:Name="Val2" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                                <TextBlock x:Name="Val3" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                                <TextBlock x:Name="Val4" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                                <TextBlock x:Name="Val5" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                                <TextBlock x:Name="Val6" Text="0" Foreground="#333" FontSize="11" FontWeight="SemiBold" Height="28" Padding="5,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Card 3: Raport miesięczny -->
                <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title + icon -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Raport miesięczny" FontWeight="Bold" FontSize="15" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#FFF8E1" CornerRadius="8" Width="32" Height="32">
                                <TextBlock Text="🏆" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Goal percentage -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cel" Foreground="#666" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtGoalPercent" Grid.Column="1" Text="0%" FontWeight="Bold" FontSize="28" Foreground="#F5A623"/>
                        </Grid>

                        <!-- Średnia dzienna / Suma spalonych -->
                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#F0F0F0" BorderThickness="0,0,1,0" Padding="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Średnia dzienna" Foreground="#999" FontSize="10" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtAvgDaily" Text="0" FontWeight="Bold" FontSize="20" Foreground="#1A1A2E"/>
                                    </StackPanel>
                                    <TextBlock Text="kcal" Foreground="#999" FontSize="10"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Suma spalonych" Foreground="#999" FontSize="10" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtTotalBurned" Text="0" FontWeight="Bold" FontSize="20" Foreground="#1A1A2E"/>
                                </StackPanel>
                                <TextBlock Text="kcal" Foreground="#999" FontSize="10"/>
                            </StackPanel>
                        </Grid>

                        <!-- Dni na fali / Streak -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Dni na fali" Foreground="#666" FontSize="12" Grid.Row="0" Grid.Column="0" Margin="0,4"/>
                            <TextBlock x:Name="TxtDaysOnGoal" Text="0 z 0" FontWeight="Bold" FontSize="13" Foreground="#5B6ABF" Grid.Row="0" Grid.Column="1" Margin="0,4" HorizontalAlignment="Right"/>

                            <TextBlock Text="Streak" Foreground="#666" FontSize="12" Grid.Row="1" Grid.Column="0" Margin="0,4"/>
                            <TextBlock x:Name="TxtStreak" Text="0 dni" FontWeight="Bold" FontSize="13" Foreground="#5B6ABF" Grid.Row="1" Grid.Column="1" Margin="0,4" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Card 4: Trend bilansu kalorii -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="250"/>
                    </Grid.RowDefinitions>

                    <!-- Title + legend -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Trend bilansu kalorii" FontWeight="Bold" FontSize="15" Foreground="#1A1A2E"/>
                            <TextBlock Text="Ostatni rok" Foreground="#999" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#2ECC71" Margin="0,0,5,0"/>
                            <TextBlock Text="Spożyte" Foreground="#666" FontSize="11" Margin="0,0,15,0"/>
                            <Ellipse Width="8" Height="8" Fill="#CCCCCC" Margin="0,0,5,0"/>
                            <TextBlock Text="Cel" Foreground="#666" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Line chart -->
                    <lvc:CartesianChart x:Name="ChartTrend" Grid.Row="1"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
