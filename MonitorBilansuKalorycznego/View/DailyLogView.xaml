<UserControl x:Class="MonitorBilansuKalorycznego.View.DailyLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F6FA" d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="CircleDataStyle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MealItemStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="15,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Date navigation -->
            <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,20">
                <Grid>
                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Click="BtnPrevDay_Click" HorizontalAlignment="Left" Width="40" Height="36"
                            Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#888" Cursor="Hand"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1E3A8A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtDate" Text="" FontWeight="Bold" FontSize="16" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Click="BtnNextDay_Click" HorizontalAlignment="Right" Width="40" Height="36"
                            Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#888" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Calorie summary card -->
            <Border Style="{StaticResource CardStyle}" Padding="25" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Dzisiejszy bilans kaloryczny (kcal)" FontWeight="Bold" FontSize="15" Foreground="#1A1A2E" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#E0F2F1">
                                <TextBlock Text="&#xE8BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10B981"/>
                            </Border>
                            <TextBlock x:Name="TxtConsumed" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Foreground="#1A1A2E"/>
                            <TextBlock Text="Spozyte" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#FFF3E0">
                                <TextBlock Text="&#xECAD;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F97316"/>
                            </Border>
                            <TextBlock x:Name="TxtBurned" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Foreground="#1A1A2E"/>
                            <TextBlock Text="Spalone" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#EDE7F6">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7C3AED"/>
                            </Border>
                            <TextBlock x:Name="TxtGoal" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Foreground="#1A1A2E"/>
                            <TextBlock Text="Cel" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#E0F7FA">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#06B6D4"/>
                            </Border>
                            <TextBlock x:Name="TxtRemaining" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Foreground="#10B981"/>
                            <TextBlock Text="Pozostale" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Dzienny postep" FontSize="12" Foreground="#666" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="0% celu" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#333"/>
                    </Grid>
                    <ProgressBar x:Name="PbDayProgress" Height="10" Margin="0,8,0,0" BorderThickness="0" Background="#F0F0F0" Foreground="#2ECC71">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- Meals and Activities side by side -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Meals card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Dzisiejsze posilki" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                            <Button Content="+ Dodaj posilek" Click="BtnAddMeal_Click" HorizontalAlignment="Right"
                                    Background="#1E3A8A" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="ListMeals">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MealItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="13" Foreground="#1A1A2E"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}" Foreground="#888" FontSize="11"/>
                                                    <TextBlock Text="g porcja" Foreground="#888" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding MealTime, StringFormat=h:mm tt}" Foreground="#BBB" FontSize="10" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0">
                                                <Run Text="{Binding CaloriesDisplay, StringFormat=N0, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#1E3A8A"/>
                                                <Run Text=" kcal" FontSize="11" Foreground="#1E3A8A"/>
                                            </TextBlock>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="BtnEditMeal_Click"
                                                        Background="Transparent" BorderThickness="0" Foreground="#CCC" FontSize="12" Cursor="Hand" Padding="4" Margin="0,0,4,0"/>
                                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="BtnDeleteMeal_Click"
                                                        Background="Transparent" BorderThickness="0" Foreground="#CCC" FontSize="12" Cursor="Hand" Padding="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Activities card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Dzisiejsze aktywnosci" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E" VerticalAlignment="Center"/>
                            <Button Content="+ Dodaj aktywnosc" Click="BtnAddActivity_Click" HorizontalAlignment="Right"
                                    Background="#F97316" Foreground="White" Padding="15,8" BorderThickness="0" FontWeight="SemiBold" FontSize="12" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="ListActivities">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MealItemStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Activity.Name}" FontWeight="SemiBold" FontSize="13" Foreground="#1A1A2E"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Duration.TotalMinutes, StringFormat=N0}" Foreground="#888" FontSize="11"/>
                                                    <TextBlock Text=" minut" Foreground="#888" FontSize="11"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StartTime, StringFormat=h:mm tt}" Foreground="#BBB" FontSize="10" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,15,0">
                                                <Run Text="{Binding CaloriesDisplay, StringFormat=N0, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#F97316"/>
                                                <Run Text=" kcal" FontSize="11" Foreground="#F97316"/>
                                            </TextBlock>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="BtnEditActivity_Click"
                                                        Background="Transparent" BorderThickness="0" Foreground="#CCC" FontSize="12" Cursor="Hand" Padding="4" Margin="0,0,4,0"/>
                                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="BtnDeleteActivity_Click"
                                                        Background="Transparent" BorderThickness="0" Foreground="#CCC" FontSize="12" Cursor="Hand" Padding="4"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel x:Name="EmptyActivitiesState" HorizontalAlignment="Center" Margin="0,40,0,0">
                            <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="#DDD"/>
                            <TextBlock Text="Dodaj wiecej cwiczen, aby sledzic swoje postepy" Foreground="#BBB" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
