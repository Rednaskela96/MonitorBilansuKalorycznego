<UserControl x:Class="MonitorBilansuKalorycznego.View.DailyLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#FAFAFA" d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="CircleDataStyle" TargetType="Border">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDD" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <Border Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,20">
                <Grid>
                    <Button Content="❮" Click="BtnPrevDay_Click" HorizontalAlignment="Left" Width="40" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#888" Cursor="Hand"/>
                    <TextBlock x:Name="TxtDate" Text="Dzisiaj, 22 Grudzień, 2025" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                    <Button Content="❯" Click="BtnNextDay_Click" HorizontalAlignment="Right" Width="40" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#888" Cursor="Hand"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Dzisiejszy bilans kaloryczny (kcal)" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#E0F2F1">
                                <TextBlock Text="🍴" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#10B981"/>
                            </Border>
                            <TextBlock x:Name="TxtConsumed" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Spożyte" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#FFF3E0">
                                <TextBlock Text="🔥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F97316"/>
                            </Border>
                            <TextBlock x:Name="TxtBurned" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Spalone" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#EDE7F6">
                                <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7C3AED"/>
                            </Border>
                            <TextBlock x:Name="TxtGoal" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cel" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <Border Style="{StaticResource CircleDataStyle}" Background="#E0F7FA">
                                <TextBlock Text="✔" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#06B6D4"/>
                            </Border>
                            <TextBlock x:Name="TxtRemaining" Text="0" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Foreground="#10B981"/>
                            <TextBlock Text="Pozostałe" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <TextBlock Text="Dzienny postęp" FontSize="12" Foreground="#666" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="0% celu" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="PbDayProgress" Height="8" Margin="0,5,0,0" BorderThickness="0" Background="#F0F0F0" Foreground="#2ECC71">
                        <ProgressBar.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Dzisiejsze posiłki" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="+ Dodaj posiłek" Click="BtnAddMeal_Click" HorizontalAlignment="Right" Background="#1E3A8A" Foreground="White" Padding="15,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="ListMeals">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Product.Name}" FontWeight="Bold" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Amount}" Foreground="#666" FontSize="12"/>
                                                <TextBlock Text="g porcja" Foreground="#666" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MealTime, StringFormat=HH:mm}" Foreground="#AAA" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CaloriesDisplay, StringFormat=N0}" 
                                                       Foreground="#1E3A8A" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                            <TextBlock Text="kcal" Foreground="#1E3A8A" FontSize="10" HorizontalAlignment="Right"/>

                                            <Button Content="🗑" Tag="{Binding}" Click="BtnDeleteMeal_Click" Margin="0,5,0,0"
                                                    Background="Transparent" BorderThickness="0" Foreground="#DDD" HorizontalAlignment="Right" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Dzisiejsze aktywności" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="+ Dodaj aktywność" Click="BtnAddActivity_Click" HorizontalAlignment="Right" Background="#F97316" Foreground="White" Padding="15,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="ListActivities">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Activity.Name}" FontWeight="Bold" FontSize="14"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Duration.TotalMinutes, StringFormat=N0}" Foreground="#666" FontSize="12"/>
                                                <TextBlock Text=" minut" Foreground="#666" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StartTime, StringFormat=HH:mm}" Foreground="#AAA" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CaloriesDisplay, StringFormat=N0}" 
                                                       Foreground="#F97316" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
                                            <TextBlock Text="kcal" Foreground="#F97316" FontSize="10" HorizontalAlignment="Right"/>

                                            <Button Content="🗑" Tag="{Binding}" Click="BtnDeleteActivity_Click" Margin="0,5,0,0"
                                                    Background="Transparent" BorderThickness="0" Foreground="#DDD" HorizontalAlignment="Right" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="EmptyActivitiesState" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="🏋️‍♂️" FontSize="40" HorizontalAlignment="Center" Opacity="0.2"/>
                        <TextBlock Text="Dodaj więcej ćwiczeń, aby śledzić swoje postępy" Foreground="#999" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>